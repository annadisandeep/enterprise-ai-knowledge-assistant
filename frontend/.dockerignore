# Keep the build context small and secrets/build-output out of the image.
# Paths are relative to the frontend/ build context.

# Installed dependencies (reinstalled with `npm ci` inside the build stage)
node_modules/

# Previous build output (rebuilt inside the image)
dist/

# Local env files — never copy real secrets into a layer
.env
.env.*

# Logs and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vite/
.cache/
coverage/

# Editor / OS noise
.DS_Store
*.local

# Docs
*.md
