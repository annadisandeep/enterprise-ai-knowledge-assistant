# Base URL of the backend API. In local dev the Vite proxy forwards /api to
# the backend (see vite.config.ts), so the default works out of the box.
VITE_API_BASE_URL=/api

# Optional: API key sent as the X-API-Key header.
#
# !!! SECURITY WARNING !!!
# Vite INLINES every VITE_* value into the built JavaScript bundle, which is
# PUBLIC. Anyone who loads the site can read this value in plain text. Therefore:
#   - NEVER put a privileged / production backend API_KEY here. Doing so leaks a
#     credential that authorizes uploads, deletes, and chat to every visitor.
#   - This is acceptable ONLY for local development, or for a trusted/internal
#     deployment where the same key is not a sensitive secret.
#   - Never put the GEMINI_API_KEY here (it is a BACKEND-ONLY secret and must
#     never reach the browser).
# For a public deployment, keep this EMPTY and protect the backend another way:
# run it privately behind IAP/a gateway, or use a backend-for-frontend proxy that
# injects the key server-side. See docs/SECURITY.md.
VITE_API_KEY=

# Optional: override the backend target for the Vite dev-server proxy.
VITE_DEV_API_TARGET=http://localhost:8000
