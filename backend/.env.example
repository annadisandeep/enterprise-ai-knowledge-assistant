# ============================================================================
# Enterprise AI Knowledge Assistant — backend environment variables
# Copy to `.env` for local development. NEVER commit a real `.env`.
# ============================================================================

# ---- General ----
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# ---- API security ----
# Shared secret required as the `X-API-Key` header on protected endpoints.
# REQUIRED in production. Leave empty locally to disable auth (dev only).
API_KEY=
# Comma-separated allowed browser origins (no spaces). Never "*" in production.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Uploads ----
MAX_UPLOAD_BYTES=10485760        # 10 MB
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.markdown

# ---- Embeddings ----
# sentence-transformers (semantic, production default) | hashing (fast, used in CI/tests)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---- Vector store ----
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=knowledge_base

# ---- Chunking ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Retrieval / RAG ----
RETRIEVAL_TOP_K=4
MIN_SIMILARITY=0.15
MAX_CONTEXT_CHARS=8000

# ---- LLM provider ----
LLM_PROVIDER=gemini              # gemini | mock
GEMINI_API_KEY=                  # REQUIRED when LLM_PROVIDER=gemini. Get one at ai.google.dev
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
